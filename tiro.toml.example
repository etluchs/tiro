# Copy to tiro.toml. This file lives in the tiro repo, not the vault.

# The vault is a sibling git repo, not a submodule (DESIGN §6).
vault = "../vault"

[run]
max_jobs = 20
max_seconds = 900
# Skip notes touched in the last N seconds: the user is probably typing (DESIGN §5.3).
skip_recent_seconds = 60
max_attempts_per_note_per_day = 3
# Daily ceilings. These are what make an unattended timer safe to leave on:
# the caps above bound one run, nothing bounded forty-eight of them. Starting
# numbers, deliberately loose — tune them after a week of real traffic
# (DESIGN open question 3). On a Claude subscription the SDK often reports no
# dollar figure, so the token ceiling is the one that always bites.
max_cost_usd_per_day = 5.0
max_tokens_per_day = 2000000
push = true

[agent]
model = "claude-opus-5"
max_turns = 30

[jobs.triage]
effort = "low"
max_seconds = 120

[jobs.research]
max_seconds = 600
max_searches = 8
# allowed_domains = []
# blocked_domains = []

[lint]
# Where unfiled notes wait. A folder, or "/" for loose notes at the vault root.
# Leave it out and lint skips the stale check. `tiro adopt` suggests a value.
inbox = "/"
stale_days = 30

[dispatch]
# Jira Cloud, posted through acli under the user's own account (DESIGN §5.5).
site = "example.atlassian.net"
project = "TIRO"          # a single key; payloads naming anything else are rejected
issue_type = "Task"
live = false              # preview mode until the payloads look right
